{
  "name": "میزکار",
  "short_name": "میزکار",
  "description": "پیش‌نمایش راست‌چین Markdown، JSON، Log، SQL و …، مقایسه، ارائه، تبدیل زمان و ماشین‌حساب شبکه — کاملاً آفلاین",
  "lang": "fa",
  "dir": "rtl",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f8",
  "theme_color": "#6d5efc",
  "categories": [
    "productivity",
    "utilities"
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
